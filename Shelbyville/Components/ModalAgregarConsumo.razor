@inject SupabaseService Supabase
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center justify-space-between w-100 pr-4">
            <div class="d-flex align-center gap-2">
                <i class="fa-solid fa-beer-mug-empty text-gold" style="font-size: 1.25rem;"></i>
                <MudText Typo="Typo.h6" Class="font-heading">Cargar Consumo - Mesa @Mesa.Numero</MudText>
            </div>
            @if (_carrito.Any())
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Outlined">
                    <i class="fa-solid fa-cart-shopping mr-1"></i> @_totalArticulos @(_totalArticulos == 1 ? "artículo" : "artículos")
                </MudChip>
            }
        </div>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="3" Class="py-1">
            <!-- Columna Izquierda: Búsqueda y Catálogo -->
            <MudItem xs="12" md="7">
                <div class="d-flex flex-column gap-3">
                    <!-- Buscador y filtro de categoría -->
                    <div class="d-flex flex-column flex-sm-row gap-2">
                        <MudTextField @bind-Value="_busqueda" 
                                      Placeholder="Buscar por nombre o código..." 
                                      Immediate="true" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" 
                                      Adornment="Adornment.Start" 
                                      AdornmentIcon="@Icons.Material.Filled.Search" 
                                      Clearable="true" 
                                      Class="flex-grow-1" />

                        @if (_categorias.Any())
                        {
                            <MudSelect T="Guid?" @bind-Value="_categoriaSeleccionadaId" 
                                       Label="Categoría" 
                                       Variant="Variant.Outlined" 
                                       Margin="Margin.Dense" 
                                       Dense="true"
                                       Style="min-width: 150px;">
                                <MudSelectItem T="Guid?" Value="@((Guid?)null)">Todas</MudSelectItem>
                                @foreach (var cat in _categorias)
                                {
                                    <MudSelectItem T="Guid?" Value="@((Guid?)cat.Id)">@cat.Nombre</MudSelectItem>
                                }
                            </MudSelect>
                        }
                    </div>

                    <div class="d-flex justify-space-between align-center">
                        <MudText Typo="Typo.caption" Style="color: var(--text-secondary); text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;">
                            Productos Disponibles (@ProductosFiltrados.Count())
                        </MudText>
                        <span style="font-size: 11px; color: var(--text-muted);">
                            <i class="fa-solid fa-hand-pointer mr-1"></i> Clic para agregar
                        </span>
                    </div>

                    <!-- Grilla con scroll de productos -->
                    <div style="max-height: 420px; overflow-y: auto; padding-right: 4px;" class="custom-scroll">
                        @if (!ProductosFiltrados.Any())
                        {
                            <div class="pa-8 text-center text-secondary">
                                <i class="fa-solid fa-box-open fa-2x mb-2" style="opacity: 0.4;"></i>
                                <p style="font-size: 13px;">No se encontraron productos disponibles con ese criterio.</p>
                            </div>
                        }
                        else
                        {
                            <MudGrid Spacing="2">
                                @foreach (var prod in ProductosFiltrados)
                                {
                                    var itemEnCarrito = _carrito.FirstOrDefault(x => x.Producto.Id == prod.Id);
                                    var cantEnCarrito = itemEnCarrito?.Cantidad ?? 0;
                                    var estaEnCarrito = cantEnCarrito > 0;
                                    var agotado = prod.Stock <= 0;
                                    var sinStockParaMas = prod.Stock <= cantEnCarrito;

                                    <MudItem xs="12" sm="6">
                                        <div class="pa-3 cursor-pointer d-flex flex-column justify-space-between"
                                             style="border-radius: 10px; 
                                                    border: 2px solid @(estaEnCarrito ? "var(--color-gold)" : "var(--border-color)"); 
                                                    background: @(estaEnCarrito ? "rgba(212, 175, 55, 0.08)" : "var(--bg-surface)"); 
                                                    min-height: 100px; 
                                                    opacity: @(agotado ? "0.55" : "1");
                                                    position: relative;
                                                    transition: all 0.2s;"
                                             @onclick="@(() => AgregarOIncrementar(prod))">

                                            @if (estaEnCarrito)
                                            {
                                                <div style="position: absolute; top: -8px; right: -8px; background: var(--color-gold); color: #0b1210; font-weight: 800; font-size: 11px; border-radius: 20px; padding: 2px 8px; box-shadow: 0 2px 6px rgba(0,0,0,0.4); z-index: 2;">
                                                    x@cantEnCarrito
                                                </div>
                                            }

                                            <div>
                                                <div class="d-flex justify-space-between align-start gap-1">
                                                    <span style="font-weight: 600; font-size: 13px; color: var(--text-primary); line-height: 1.25;">
                                                        @prod.Nombre
                                                    </span>
                                                    <span class="text-gold font-heading" style="font-weight: 700; font-size: 14px; white-space: nowrap;">
                                                        Bs. @prod.PrecioVenta.ToString("N2")
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="d-flex justify-space-between align-center mt-2">
                                                <span style="font-size: 11.5px; color: @(agotado || prod.StockBajo ? "var(--status-pausada)" : "var(--text-secondary)");">
                                                    Stock: @prod.Stock u.
                                                </span>

                                                @if (agotado)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text" Class="pa-0 ma-0" Style="font-size: 11px;">
                                                        Agotado
                                                    </MudChip>
                                                }
                                                else if (estaEnCarrito)
                                                {
                                                    <div class="d-flex align-center gap-1" @onclick:stopPropagation="true">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Remove" 
                                                                       Size="Size.Small" 
                                                                       Variant="Variant.Filled"
                                                                       Color="Color.Default"
                                                                       Style="width: 24px; height: 24px; min-width: 24px; padding: 0;"
                                                                       OnClick="@(() => DisminuirCantidad(prod.Id))" />
                                                        <span style="font-weight: 700; font-size: 12.5px; min-width: 20px; text-align: center;">@cantEnCarrito</span>
                                                        <MudIconButton Icon="@Icons.Material.Filled.Add" 
                                                                       Size="Size.Small" 
                                                                       Variant="Variant.Filled"
                                                                       Color="Color.Tertiary"
                                                                       Style="width: 24px; height: 24px; min-width: 24px; padding: 0;"
                                                                       Disabled="sinStockParaMas"
                                                                       OnClick="@(() => IncrementarCantidad(prod.Id))" />
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span style="font-size: 11px; color: var(--color-gold); font-weight: 600;">
                                                        <i class="fa-solid fa-plus mr-1"></i> Agregar
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </MudItem>
                                }
                            </MudGrid>
                        }
                    </div>
                </div>
            </MudItem>

            <!-- Columna Derecha: Resumen de Consumos a Cargar -->
            <MudItem xs="12" md="5">
                <MudPaper Elevation="0" Class="pa-3 d-flex flex-column h-100" 
                          Style="background: var(--bg-elevated); border: 1px solid var(--border-color); border-radius: 12px; min-height: 430px;">
                    <div class="d-flex justify-space-between align-center pb-2 mb-2" style="border-bottom: 1px solid var(--border-color);">
                        <div class="d-flex align-center gap-2">
                            <i class="fa-solid fa-receipt text-gold"></i>
                            <MudText Typo="Typo.subtitle1" Class="font-heading" Style="font-weight: 600; font-size: 14.5px;">Consumos a Cargar</MudText>
                        </div>
                        @if (_carrito.Any())
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="LimpiarCarrito" StartIcon="@Icons.Material.Filled.DeleteSweep">
                                Vaciar
                            </MudButton>
                        }
                    </div>

                    @if (!_carrito.Any())
                    {
                        <div class="d-flex flex-column align-center justify-center flex-grow-1 text-center py-6" style="color: var(--text-muted);">
                            <i class="fa-solid fa-cart-shopping fa-3x mb-3" style="opacity: 0.3;"></i>
                            <p style="font-size: 14px; margin: 0; font-weight: 600; color: var(--text-secondary);">Ningún producto seleccionado</p>
                            <p style="font-size: 12px; margin-top: 6px; color: var(--text-muted); max-width: 220px;">
                                Selecciona varios productos del catálogo de la izquierda para cargarlos juntos a la cuenta de la mesa.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="flex-grow-1 custom-scroll" style="max-height: 290px; overflow-y: auto; padding-right: 2px;">
                            <div class="d-flex flex-column gap-2">
                                @foreach (var item in _carrito)
                                {
                                    <div class="pa-2 d-flex align-center justify-space-between" 
                                         style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 8px;">
                                        <div style="flex: 1; min-width: 0;" class="mr-2">
                                            <div style="font-weight: 600; font-size: 12.5px; color: var(--text-primary); text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                                @item.Producto.Nombre
                                            </div>
                                            <div style="font-size: 11.5px; color: var(--text-secondary);">
                                                Bs. @item.Producto.PrecioVenta.ToString("N2") c/u • <strong class="text-gold">Bs. @item.Subtotal.ToString("N2")</strong>
                                            </div>
                                        </div>

                                        <div class="d-flex align-center gap-1">
                                            <MudIconButton Icon="@Icons.Material.Filled.Remove" 
                                                           Size="Size.Small" 
                                                           OnClick="@(() => DisminuirCantidad(item.Producto.Id))" 
                                                           Style="width: 26px; height: 26px; min-width: 26px;" />
                                            <span style="font-weight: 700; font-size: 12.5px; min-width: 20px; text-align: center;">@item.Cantidad</span>
                                            <MudIconButton Icon="@Icons.Material.Filled.Add" 
                                                           Size="Size.Small" 
                                                           Disabled="@(item.Cantidad >= item.Producto.Stock)" 
                                                           OnClick="@(() => IncrementarCantidad(item.Producto.Id))" 
                                                           Style="width: 26px; height: 26px; min-width: 26px;" />
                                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" 
                                                           Color="Color.Error" 
                                                           Size="Size.Small" 
                                                           OnClick="@(() => EliminarItem(item.Producto.Id))" 
                                                           Style="width: 26px; height: 26px; min-width: 26px;" />
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Resumen inferior -->
                        <div class="pt-3 mt-2" style="border-top: 1px dashed var(--border-color);">
                            <div class="d-flex justify-space-between align-center mb-1" style="font-size: 12px; color: var(--text-secondary);">
                                <span>Total artículos:</span>
                                <span style="font-weight: 600; color: var(--text-primary);">@_totalArticulos unidades</span>
                            </div>
                            <div class="d-flex justify-space-between align-center">
                                <span class="font-heading" style="font-size: 14px; font-weight: 600;">Total a Cargar:</span>
                                <span class="font-heading text-gold" style="font-size: 18px; font-weight: 700;">
                                    Bs. @_totalMonto.ToString("N2")
                                </span>
                            </div>
                        </div>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Text">Cancelar</MudButton>
        <MudButton Color="Color.Tertiary" 
                   Variant="Variant.Filled" 
                   OnClick="ConfirmarConsumos" 
                   Disabled="!_carrito.Any() || _procesando" 
                   Class="btn-touch">
            @if (_procesando)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Cargando consumos...</span>
            }
            else
            {
                <i class="fa-solid fa-check mr-2"></i>
                @if (_carrito.Any())
                {
                    <span>Cargar a la Mesa (@_totalArticulos art. - Bs. @_totalMonto.ToString("N2"))</span>
                }
                else
                {
                    <span>Cargar a la Mesa</span>
                }
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    public class ItemConsumo
    {
        public ProductoModel Producto { get; set; } = default!;
        public int Cantidad { get; set; } = 1;
        public decimal Subtotal => Cantidad * Producto.PrecioVenta;
    }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public MesaModel Mesa { get; set; } = default!;

    [Parameter]
    public List<ProductoModel> Productos { get; set; } = new();

    private string _busqueda = string.Empty;
    private Guid? _categoriaSeleccionadaId;
    private List<CategoriaModel> _categorias = new();
    private List<ItemConsumo> _carrito = new();
    private bool _procesando;

    private int _totalArticulos => _carrito.Sum(x => x.Cantidad);
    private decimal _totalMonto => _carrito.Sum(x => x.Subtotal);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _categorias = await Supabase.GetCategoriasAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar categorías en modal consumo: {ex.Message}");
        }
    }

    private IEnumerable<ProductoModel> ProductosFiltrados =>
        Productos
            .Where(p => p.Activo)
            .Where(p => _categoriaSeleccionadaId == null || p.CategoriaId == _categoriaSeleccionadaId)
            .Where(p => string.IsNullOrWhiteSpace(_busqueda) 
                        || p.Nombre.Contains(_busqueda, StringComparison.OrdinalIgnoreCase)
                        || (!string.IsNullOrEmpty(p.Codigo) && p.Codigo.Contains(_busqueda, StringComparison.OrdinalIgnoreCase)));

    private void AgregarOIncrementar(ProductoModel prod)
    {
        if (prod.Stock <= 0) return;

        var item = _carrito.FirstOrDefault(x => x.Producto.Id == prod.Id);
        if (item != null)
        {
            if (item.Cantidad < prod.Stock)
            {
                item.Cantidad++;
            }
            else
            {
                Snackbar.Add($"Stock máximo alcanzado para {prod.Nombre} ({prod.Stock} u.)", Severity.Warning);
            }
        }
        else
        {
            _carrito.Add(new ItemConsumo
            {
                Producto = prod,
                Cantidad = 1
            });
        }
    }

    private void IncrementarCantidad(Guid productoId)
    {
        var item = _carrito.FirstOrDefault(x => x.Producto.Id == productoId);
        if (item != null && item.Cantidad < item.Producto.Stock)
        {
            item.Cantidad++;
        }
    }

    private void DisminuirCantidad(Guid productoId)
    {
        var item = _carrito.FirstOrDefault(x => x.Producto.Id == productoId);
        if (item != null)
        {
            if (item.Cantidad > 1)
            {
                item.Cantidad--;
            }
            else
            {
                _carrito.Remove(item);
            }
        }
    }

    private void EliminarItem(Guid productoId)
    {
        _carrito.RemoveAll(x => x.Producto.Id == productoId);
    }

    private void LimpiarCarrito()
    {
        _carrito.Clear();
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task ConfirmarConsumos()
    {
        if (Mesa.SesionActiva == null || !_carrito.Any()) return;

        _procesando = true;
        var consumos = _carrito.Select(c => (ProductoId: c.Producto.Id, Cantidad: c.Cantidad)).ToList();
        var (exito, procesados, error) = await Supabase.AgregarVariosConsumosMesaAsync(Mesa.SesionActiva.Id, consumos);
        _procesando = false;

        if (exito)
        {
            Snackbar.Add($"Se cargaron {procesados} artículos a la Mesa {Mesa.Numero}", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add($"Error al cargar los consumos a la mesa: {error ?? "Ocurrió un error inesperado"}", Severity.Error);
        }
    }
}
