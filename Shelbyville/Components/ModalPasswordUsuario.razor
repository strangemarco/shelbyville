@inject SupabaseService Supabase
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Warning" />
            <MudText Typo="Typo.h6" Class="font-heading">
                Cambiar Contraseña: @Perfil.NombreCompleto
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-3 py-2">
            <div class="pa-3" style="background: rgba(245, 158, 11, 0.08); border-radius: 8px; border: 1px solid rgba(245, 158, 11, 0.25);">
                <div style="font-size: 13px; color: var(--text-primary); font-weight: 600;">
                    Asignación de Nueva Clave de Acceso
                </div>
                <div style="font-size: 12px; color: var(--text-secondary); margin-top: 2px;">
                    Esta acción actualizará inmediatamente la contraseña para la cuenta <b>@(Perfil.Email ?? Perfil.NombreCompleto)</b>. El usuario deberá ingresar con esta nueva clave en su siguiente inicio de sesión.
                </div>
            </div>

            <MudTextField @bind-Value="_nuevaPassword" Label="Nueva Contraseña" Placeholder="Mínimo 6 caracteres" Required="true" Variant="Variant.Outlined" InputType="_mostrarPassword ? InputType.Text : InputType.Password" Adornment="Adornment.End" AdornmentIcon="@(_mostrarPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)" OnAdornmentClick="@(() => _mostrarPassword = !_mostrarPassword)" />

            <MudTextField @bind-Value="_confirmarPassword" Label="Confirmar Nueva Contraseña" Placeholder="Repite la contraseña" Required="true" Variant="Variant.Outlined" InputType="_mostrarPassword ? InputType.Text : InputType.Password" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Text">Cancelar</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="GuardarAsync" Disabled="_procesando" Class="btn-touch" Style="font-weight: 700;">
            @if (_procesando)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Actualizando...</span>
            }
            else
            {
                <span>Actualizar Contraseña</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public PerfilModel Perfil { get; set; } = default!;

    private string _nuevaPassword = string.Empty;
    private string _confirmarPassword = string.Empty;
    private bool _mostrarPassword;
    private bool _procesando;

    private void Cancelar() => MudDialog.Cancel();

    private async Task GuardarAsync()
    {
        if (string.IsNullOrWhiteSpace(_nuevaPassword) || _nuevaPassword.Length < 6)
        {
            Snackbar.Add("La contraseña debe tener al menos 6 caracteres", Severity.Warning);
            return;
        }

        if (_nuevaPassword != _confirmarPassword)
        {
            Snackbar.Add("Las contraseñas no coinciden", Severity.Warning);
            return;
        }

        _procesando = true;
        var (exito, mensaje) = await Supabase.AdminCambiarPasswordAsync(Perfil.Id, _nuevaPassword);
        _procesando = false;

        if (exito)
        {
            Snackbar.Add($"Contraseña de '{Perfil.NombreCompleto}' actualizada con éxito", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add($"Error al cambiar contraseña: {mensaje ?? "Verifica la base de datos"}", Severity.Error);
        }
    }
}
