@inherits LayoutComponentBase
@inject SupabaseService Supabase
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@implements IDisposable

<MudLayout>
    <!-- Top AppBar (Debe ir primero para calcular el offset de MudLayout y ClipMode) -->
    <MudAppBar Fixed="true" Elevation="1" Style="background-color: var(--bg-sidebar); border-bottom: 1px solid var(--border-color); backdrop-filter: blur(8px); z-index: 1201;">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        
        <div class="d-flex align-center ml-2 cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/"))">
            <img src="images/LogoShelbyville.png" alt="Shelbyville Billar" style="height: 38px; width: auto; object-fit: contain; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.7));" />
        </div>

        <MudSpacer />

        <!-- Reloj en tiempo real -->
        <div class="d-none d-md-flex align-center px-4 py-1 mr-3 tabular-nums" style="background: rgba(28, 41, 35, 0.6); border: 1px solid var(--border-color); border-radius: 8px;">
            <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Style="color: var(--color-gold); margin-right: 8px;" />
            <span style="font-size: 13px; font-weight: 600; color: var(--text-primary);">
                @_horaActual
            </span>
        </div>

        <!-- Indicador de Caja -->
        <div>
            @if (_cajaAbierta != null)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.CheckCircle">
                    Caja Abierta: @(_cajaAbierta.Nombre)
                </MudChip>
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Lock">
                    Caja Cerrada
                </MudChip>
            }
        </div>
    </MudAppBar>

    <!-- Drawer / Sidebar -->
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Variant="DrawerVariant.Responsive" Width="260px" Style="background-color: var(--bg-sidebar);">
        <NavMenu />
    </MudDrawer>

    <!-- Main Content con padding-top para no colisionar con AppBar -->
    <MudMainContent Class="pt-20 px-4 px-md-6 pb-6" Style="background-color: var(--bg-main); min-height: 100vh;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private string _horaActual = DateTime.Now.ToString("HH:mm:ss");
    private System.Threading.Timer? _relojTimer;
    private CajaModel? _cajaAbierta;
    private PerfilModel? _perfil;

    protected override async Task OnInitializedAsync()
    {
        _relojTimer = new System.Threading.Timer(_ =>
        {
            _horaActual = DateTime.Now.ToString("HH:mm:ss");
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);

        Supabase.OnAuthStateChange += OnAuthChanged;

        // Restaurar sesión persistida si se refrescó la página
        await Supabase.RestaurarSesionAsync();

        await CargarEstadoAsync();
    }

    private void OnAuthChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await CargarEstadoAsync();
        });
    }

    private async Task CargarEstadoAsync()
    {
        try
        {
            _cajaAbierta = await Supabase.GetCajaAbiertaAsync();
            _perfil = await Supabase.GetPerfilUsuarioAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando estado layout: {ex.Message}");
        }
    }

    private async Task CerrarSesion()
    {
        await Supabase.SignOutAsync();
        _perfil = null;
        Snackbar.Add("Sesión finalizada", Severity.Info);
        Navigation.NavigateTo("/login");
    }

    private string ObtenerIniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "U";
        var partes = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 1) return partes[0].Substring(0, Math.Min(2, partes[0].Length)).ToUpperInvariant();
        return $"{partes[0][0]}{partes[1][0]}".ToUpperInvariant();
    }

    public void Dispose()
    {
        _relojTimer?.Dispose();
        Supabase.OnAuthStateChange -= OnAuthChanged;
    }
}
