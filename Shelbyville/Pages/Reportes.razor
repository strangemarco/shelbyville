@page "/reportes"
@inject SupabaseService Supabase

<div class="d-flex flex-column gap-5">
    <!-- Header -->
    <div class="d-flex justify-space-between align-center">
        <div>
            <h1 class="font-heading ma-0" style="font-size: 28px; font-weight: 800; color: var(--color-gold);">
                ESTADÍSTICAS Y REPORTES
            </h1>
            <p class="ma-0 mt-1" style="color: var(--text-secondary); font-size: 14px;">
                Métricas de facturación, desglose por métodos de pago y rendimiento del salón.
            </p>
        </div>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" Color="Color.Tertiary" OnClick="CargarReportesAsync" />
    </div>

    <!-- Tarjetas de Resumen Financiero -->
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6" md="4">
            <div class="shelby-card pa-4 d-flex justify-space-between align-center">
                <div>
                    <div style="font-size: 12px; color: var(--text-secondary); text-transform: uppercase;">Total Recaudado (Turno Actual)</div>
                    <div class="font-heading text-gold mt-1 tabular-nums" style="font-size: 26px; font-weight: 800;">
                        Bs. @TotalRecaudado.ToString("N2")
                    </div>
                </div>
                <div class="pa-3" style="background: rgba(212, 175, 55, 0.15); border-radius: 12px; border: 1px solid rgba(212, 175, 55, 0.3);">
                    <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Color="Color.Tertiary" Size="Size.Medium" />
                </div>
            </div>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <div class="shelby-card pa-4 d-flex justify-space-between align-center">
                <div>
                    <div style="font-size: 12px; color: var(--text-secondary); text-transform: uppercase;">Cobros en Efectivo</div>
                    <div class="font-heading mt-1 tabular-nums" style="font-size: 26px; font-weight: 800; color: var(--status-disponible);">
                        Bs. @((_caja?.MontoVentasEfectivo ?? 0).ToString("N2"))
                    </div>
                </div>
                <div class="pa-3" style="background: rgba(34, 197, 94, 0.15); border-radius: 12px; border: 1px solid rgba(34, 197, 94, 0.3);">
                    <MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Success" Size="Size.Medium" />
                </div>
            </div>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <div class="shelby-card pa-4 d-flex justify-space-between align-center">
                <div>
                    <div style="font-size: 12px; color: var(--text-secondary); text-transform: uppercase;">Cobros Digitales (QR / Tarjeta)</div>
                    <div class="font-heading mt-1 tabular-nums" style="font-size: 26px; font-weight: 800; color: var(--status-reservada);">
                        Bs. @(((_caja?.MontoVentasQr ?? 0) + (_caja?.MontoVentasTarjeta ?? 0)).ToString("N2"))
                    </div>
                </div>
                <div class="pa-3" style="background: rgba(56, 189, 248, 0.15); border-radius: 12px; border: 1px solid rgba(56, 189, 248, 0.3);">
                    <MudIcon Icon="@Icons.Material.Filled.QrCode2" Color="Color.Info" Size="Size.Medium" />
                </div>
            </div>
        </MudItem>
    </MudGrid>

    <!-- Información adicional y distribución -->
    <MudGrid Spacing="3">
        <MudItem xs="12" md="6">
            <div class="shelby-card pa-5 h-100" style="background: var(--bg-surface);">
                <div class="d-flex align-center gap-2 pb-2 mb-3" style="border-bottom: 1px solid var(--border-color);">
                    <MudIcon Icon="@Icons.Material.Filled.PieChart" Color="Color.Tertiary" />
                    <span class="font-heading" style="font-weight: 700; font-size: 16px;">Distribución de Cobros por Canal</span>
                </div>
                <div class="d-flex flex-column gap-3">
                    <div>
                        <div class="d-flex justify-space-between" style="font-size: 13px;">
                            <span>Efectivo</span>
                            <span class="tabular-nums" style="font-weight: 600;">Bs. @((_caja?.MontoVentasEfectivo ?? 0).ToString("N2"))</span>
                        </div>
                        <MudProgressLinear Color="Color.Success" Value="@(TotalRecaudado > 0 ? (double)((_caja?.MontoVentasEfectivo ?? 0) / TotalRecaudado * 100) : 0)" Class="my-1 rounded-sm" />
                    </div>
                    <div>
                        <div class="d-flex justify-space-between" style="font-size: 13px;">
                            <span>Transferencia / QR</span>
                            <span class="tabular-nums" style="font-weight: 600;">Bs. @((_caja?.MontoVentasQr ?? 0).ToString("N2"))</span>
                        </div>
                        <MudProgressLinear Color="Color.Info" Value="@(TotalRecaudado > 0 ? (double)((_caja?.MontoVentasQr ?? 0) / TotalRecaudado * 100) : 0)" Class="my-1 rounded-sm" />
                    </div>
                    <div>
                        <div class="d-flex justify-space-between" style="font-size: 13px;">
                            <span>Tarjeta de Débito/Crédito</span>
                            <span class="tabular-nums" style="font-weight: 600;">Bs. @((_caja?.MontoVentasTarjeta ?? 0).ToString("N2"))</span>
                        </div>
                        <MudProgressLinear Color="Color.Warning" Value="@(TotalRecaudado > 0 ? (double)((_caja?.MontoVentasTarjeta ?? 0) / TotalRecaudado * 100) : 0)" Class="my-1 rounded-sm" />
                    </div>
                </div>
            </div>
        </MudItem>

        <MudItem xs="12" md="6">
            <div class="shelby-card pa-5 h-100" style="background: var(--bg-surface);">
                <div class="d-flex align-center gap-2 pb-2 mb-3" style="border-bottom: 1px solid var(--border-color);">
                    <MudIcon Icon="@Icons.Material.Filled.SportsScore" Color="Color.Tertiary" />
                    <span class="font-heading" style="font-weight: 700; font-size: 16px;">Ocupación Actual de Mesas</span>
                </div>
                <div class="d-flex align-center justify-center py-4">
                    <div class="text-center">
                        <div class="font-heading text-gold tabular-nums" style="font-size: 48px; font-weight: 800;">
                            @PorcentajeOcupacion%
                        </div>
                        <div style="font-size: 13px; color: var(--text-secondary); margin-top: 4px;">
                            @_mesas.Count(m => m.Estado == "ocupada") de @_mesas.Count mesas en juego
                        </div>
                    </div>
                </div>
            </div>
        </MudItem>
    </MudGrid>
</div>

@code {
    private CajaModel? _caja;
    private List<MesaModel> _mesas = new();

    private decimal TotalRecaudado => (_caja?.MontoVentasEfectivo ?? 0) + (_caja?.MontoVentasQr ?? 0) + (_caja?.MontoVentasTarjeta ?? 0);
    private int PorcentajeOcupacion => _mesas.Count > 0 ? (int)Math.Round((double)_mesas.Count(m => m.Estado == "ocupada") / _mesas.Count * 100) : 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarReportesAsync();
    }

    private async Task CargarReportesAsync()
    {
        _caja = await Supabase.GetCajaAbiertaAsync();
        _mesas = await Supabase.GetMesasAsync();
    }
}
