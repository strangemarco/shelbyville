@page "/inventario"
@inject SupabaseService Supabase
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ExcelExportService ExcelService

<div class="d-flex flex-column gap-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center gap-3">
        <div>
            <h1 class="font-heading ma-0" style="font-size: 28px; font-weight: 800; color: var(--color-gold);">
                CONTROL DE INVENTARIO Y KARDEX
            </h1>
            <p class="ma-0 mt-1" style="color: var(--text-secondary); font-size: 14px;">
                Existencias físicas, registro de entradas de mercadería y alertas de reposición.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Tertiary" 
                       StartIcon="@Icons.Custom.FileFormats.FileExcel" 
                       Class="btn-touch" 
                       Style="border-color: rgba(34, 197, 94, 0.5); color: #4ADE80; background: rgba(34, 197, 94, 0.08); font-weight: 600;"
                       OnClick="ExportarAExcelAsync" 
                       Disabled="_exportando">
                @if (_exportando)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Exportando...</span>
                }
                else
                {
                    <span>Exportar Excel</span>
                }
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.AddShoppingCart" Class="btn-touch" OnClick="AbrirModalEntradaStockGlobal">
                + Entrada de Mercadería
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.AddBox" Class="btn-touch" Style="background: var(--color-gold); color: #0B1210; font-weight: 700;" OnClick="AbrirModalNuevoProducto">
                + Nuevo Producto
            </MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" Color="Color.Tertiary" OnClick="CargarInventarioAsync" />
        </div>
    </div>

    <!-- Alertas de Stock Bajo -->
    @{
        var articulosBajos = _productos.Where(p => p.StockBajo).ToList();
    }
    @if (articulosBajos.Any())
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="rounded-lg">
            <b>Atención:</b> Se detectaron @articulosBajos.Count artículo(s) con existencias iguales o por debajo del stock mínimo establecido.
        </MudAlert>
    }

    <!-- Grilla de inventario -->
    <MudTable Items="_productos" Dense="true" Hover="true" Elevation="1" Class="shelby-card" Style="background: var(--bg-surface);">
        <HeaderContent>
            <MudTh>Código</MudTh>
            <MudTh>Artículo</MudTh>
            <MudTh Style="text-align: right;">Costo Compra</MudTh>
            <MudTh Style="text-align: right;">Precio Venta</MudTh>
            <MudTh Style="text-align: center;">Stock Mínimo</MudTh>
            <MudTh Style="text-align: center;">Stock Actual</MudTh>
            <MudTh Style="text-align: right;">Valor Total</MudTh>
            <MudTh Style="text-align: center;">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Style="font-family: monospace; color: var(--text-secondary);">@(context.Codigo ?? "-")</MudTd>
            <MudTd>
                <div style="font-weight: 600;">@context.Nombre</div>
            </MudTd>
            <MudTd Style="text-align: right;" Class="tabular-nums">Bs. @context.PrecioCompra.ToString("N2")</MudTd>
            <MudTd Style="text-align: right; font-weight: 700;" Class="tabular-nums font-heading text-gold">Bs. @context.PrecioVenta.ToString("N2")</MudTd>
            <MudTd Style="text-align: center;">@context.StockMinimo u.</MudTd>
            <MudTd Style="text-align: center;">
                @if (context.Stock <= 0)
                {
                    <span class="px-2 py-1" style="background: rgba(239, 68, 68, 0.2); color: var(--status-ocupada); border-radius: 6px; font-weight: 700;">
                        0 u. (Agotado)
                    </span>
                }
                else if (context.StockBajo)
                {
                    <span class="px-2 py-1" style="background: rgba(245, 158, 11, 0.2); color: var(--status-pausada); border-radius: 6px; font-weight: 700;">
                        @context.Stock u. (Crítico)
                    </span>
                }
                else
                {
                    <span class="px-2 py-1" style="background: rgba(34, 197, 94, 0.2); color: var(--status-disponible); border-radius: 6px; font-weight: 700;">
                        @context.Stock u.
                    </span>
                }
            </MudTd>
            <MudTd Style="text-align: right; font-weight: 700;" Class="tabular-nums font-heading">
                Bs. @((context.Stock * context.PrecioCompra).ToString("N2"))
            </MudTd>
            <MudTd Style="text-align: center;">
                <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AbrirModalEntradaFila(context))">
                    + Stock
                </MudButton>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 8, 15, 25, 50, 100 }"
                           RowsPerPageString="Filas por página:"
                           InfoFormat="{first_item}-{last_item} de {all_items}"
                           AllItemsText="Todos" />
        </PagerContent>
    </MudTable>
</div>

@code {
    private List<ProductoModel> _productos = new();
    private List<CategoriaModel> _categorias = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarInventarioAsync();
    }

    private async Task CargarInventarioAsync()
    {
        _productos = await Supabase.GetProductosAsync();
        _categorias = await Supabase.GetCategoriasAsync();
    }

    private async Task AbrirModalNuevoProducto()
    {
        var parameters = new DialogParameters<ModalProducto>
        {
            { x => x.Categorias, _categorias }
        };

        var dialog = await DialogService.ShowAsync<ModalProducto>("Nuevo Producto", parameters);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            await CargarInventarioAsync();
        }
    }

    private async Task AbrirModalEntradaStockGlobal()
    {
        var parameters = new DialogParameters<ModalAjusteStock>
        {
            { x => x.Productos, _productos }
        };

        var dialog = await DialogService.ShowAsync<ModalAjusteStock>("Entrada de Stock", parameters);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            await CargarInventarioAsync();
        }
    }

    private async Task AbrirModalEntradaFila(ProductoModel prod)
    {
        var parameters = new DialogParameters<ModalAjusteStock>
        {
            { x => x.ProductoFijo, prod },
            { x => x.Productos, _productos }
        };

        var dialog = await DialogService.ShowAsync<ModalAjusteStock>($"Ingresar Stock: {prod.Nombre}", parameters);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            await CargarInventarioAsync();
        }
    }

    private bool _exportando;

    private async Task ExportarAExcelAsync()
    {
        if (_productos == null || _productos.Count == 0)
        {
            Snackbar.Add("No hay artículos en el inventario para exportar.", Severity.Warning);
            return;
        }

        try
        {
            _exportando = true;
            await ExcelService.ExportarInventarioAsync(_productos, _categorias);
            Snackbar.Add("Inventario exportado a Excel exitosamente.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar a Excel: {ex.Message}", Severity.Error);
        }
        finally
        {
            _exportando = false;
        }
    }
}
