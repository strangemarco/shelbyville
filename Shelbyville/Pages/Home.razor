@page "/"
@inject SupabaseService Supabase
@inject NavigationManager Navigation
@implements IDisposable

<div class="d-flex flex-column gap-5">
    <!-- Hero Banner -->
    <div class="pa-6 d-flex flex-column flex-md-row justify-space-between align-start align-md-center gap-4" 
         style="background: radial-gradient(circle at 10% 20%, #164F3B 0%, #101B16 80%); border: 1px solid var(--border-color); border-radius: 16px; box-shadow: 0 8px 32px rgba(0,0,0,0.4);">
        <div>
            <div class="d-flex align-center gap-2 mb-2">
                <span class="px-2 py-0-5 text-gold" style="background: rgba(212, 175, 55, 0.15); border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 6px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">
                    Panel de Administración
                </span>
            </div>
            <h1 class="font-heading ma-0" style="font-size: 32px; font-weight: 800; color: #FFFFFF; letter-spacing: 0.5px;">
                Shelbyville Billiard Lounge
            </h1>
            <p class="ma-0 mt-2" style="color: var(--text-secondary); font-size: 14px; max-width: 600px;">
                Control en tiempo real de mesas de billar, punto de venta de barra, kardex de inventario y arqueos de caja.
            </p>
        </div>

        <!-- Acciones rápidas del hero -->
        <div class="d-flex flex-wrap gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.SportsScore" Class="btn-touch" Style="background: var(--color-gold); color: #0B1210; font-weight: 700;" OnClick="@(() => Navigation.NavigateTo("/mesas"))">
                Ver Mesas en Vivo
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.PointOfSale" Class="btn-touch" OnClick="@(() => Navigation.NavigateTo("/pos"))">
                Venta Rápida POS
            </MudButton>
        </div>
    </div>

    <!-- KPIs del Negocio -->
    <MudGrid Spacing="3">
        <!-- KPI 1: Mesas Disponibles -->
        <MudItem xs="12" sm="6" md="3">
            <div class="shelby-card pa-4 d-flex justify-space-between align-center h-100">
                <div>
                    <div style="font-size: 12px; color: var(--text-secondary); text-transform: uppercase; font-weight: 600;">Mesas Disponibles</div>
                    <div class="font-heading mt-1" style="font-size: 28px; font-weight: 800; color: var(--status-disponible);">
                        @_mesas.Count(m => m.Estado == "disponible") <span style="font-size: 16px; color: var(--text-muted); font-weight: 500;">/ @_mesas.Count</span>
                    </div>
                </div>
                <div class="pa-3" style="background: rgba(34, 197, 94, 0.15); border-radius: 12px; border: 1px solid rgba(34, 197, 94, 0.3);">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Medium" />
                </div>
            </div>
        </MudItem>

        <!-- KPI 2: Mesas en Juego -->
        <MudItem xs="12" sm="6" md="3">
            <div class="shelby-card pa-4 d-flex justify-space-between align-center h-100">
                <div>
                    <div style="font-size: 12px; color: var(--text-secondary); text-transform: uppercase; font-weight: 600;">Mesas Ocupadas</div>
                    <div class="font-heading mt-1" style="font-size: 28px; font-weight: 800; color: var(--status-ocupada);">
                        @_mesas.Count(m => m.Estado == "ocupada")
                    </div>
                </div>
                <div class="pa-3" style="background: rgba(239, 68, 68, 0.15); border-radius: 12px; border: 1px solid rgba(239, 68, 68, 0.3);">
                    <MudIcon Icon="@Icons.Material.Filled.SportsScore" Color="Color.Error" Size="Size.Medium" />
                </div>
            </div>
        </MudItem>

        <!-- KPI 3: Estado de Caja -->
        <MudItem xs="12" sm="6" md="3">
            <div class="shelby-card pa-4 d-flex justify-space-between align-center h-100">
                <div>
                    <div style="font-size: 12px; color: var(--text-secondary); text-transform: uppercase; font-weight: 600;">Ventas en Turno</div>
                    <div class="font-heading mt-1 tabular-nums" style="font-size: 28px; font-weight: 800; color: var(--color-gold);">
                        Bs. @((_caja?.MontoVentasEfectivo + _caja?.MontoVentasQr + _caja?.MontoVentasTarjeta ?? 0).ToString("N2"))
                    </div>
                </div>
                <div class="pa-3" style="background: rgba(212, 175, 55, 0.15); border-radius: 12px; border: 1px solid rgba(212, 175, 55, 0.3);">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Tertiary" Size="Size.Medium" />
                </div>
            </div>
        </MudItem>

        <!-- KPI 4: Alertas de Stock -->
        <MudItem xs="12" sm="6" md="3">
            <div class="shelby-card pa-4 d-flex justify-space-between align-center h-100">
                <div>
                    <div style="font-size: 12px; color: var(--text-secondary); text-transform: uppercase; font-weight: 600;">Stock Bajo / Alertas</div>
                    <div class="font-heading mt-1" style="font-size: 28px; font-weight: 800; color: @(_productosBajoStock > 0 ? "var(--status-pausada)" : "var(--status-disponible)");">
                        @_productosBajoStock <span style="font-size: 14px; font-weight: 500; color: var(--text-muted);">artículos</span>
                    </div>
                </div>
                <div class="pa-3" style="background: rgba(245, 158, 11, 0.15); border-radius: 12px; border: 1px solid rgba(245, 158, 11, 0.3);">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Medium" />
                </div>
            </div>
        </MudItem>
    </MudGrid>

    <!-- Vista Rápida del Salón de Billar -->
    <div class="d-flex justify-space-between align-center mt-2">
        <div>
            <h2 class="font-heading ma-0" style="font-size: 20px; font-weight: 700; color: var(--text-primary);">
                Estado del Salón de Billar
            </h2>
            <span style="font-size: 13px; color: var(--text-secondary);">Acceso inmediato al estado y cronómetros de las mesas</span>
        </div>
        <MudButton Variant="Variant.Text" Color="Color.Tertiary" EndIcon="@Icons.Material.Filled.ArrowForward" OnClick="@(() => Navigation.NavigateTo("/mesas"))">
            Ver todas las mesas
        </MudButton>
    </div>

    <!-- Grilla Resumida de Mesas -->
    <MudGrid Spacing="2">
        @foreach (var mesa in _mesas)
        {
            var enJuego = mesa.Estado == "ocupada";
            var pausada = mesa.Estado == "pausada";
            var disponible = mesa.Estado == "disponible";

            <MudItem xs="6" sm="4" md="3">
                <div class="shelby-card pa-3 cursor-pointer" 
                     style="background: var(--bg-surface); border: 2px solid @(enJuego ? "var(--status-ocupada)" : (pausada ? "var(--status-pausada)" : "var(--border-color)"));"
                     @onclick="@(() => Navigation.NavigateTo("/mesas"))">
                    <div class="d-flex justify-space-between align-center">
                        <span class="font-heading" style="font-weight: 800; color: var(--color-gold); font-size: 16px;">
                            Mesa @mesa.Numero
                        </span>
                        <span style="font-size: 11px; font-weight: 700; color: @(disponible ? "var(--status-disponible)" : (enJuego ? "var(--status-ocupada)" : "var(--status-pausada)"));">
                            @(disponible ? "Libre" : (enJuego ? "En Juego" : "Pausada"))
                        </span>
                    </div>

                    @if (!disponible)
                    {
                        <div class="mt-2 text-center py-1 tabular-nums" style="background: var(--bg-elevated); border-radius: 6px; font-weight: 700; color: #FFFFFF; font-size: 16px;">
                            @mesa.TiempoTranscurridoStr
                        </div>
                        <div class="d-flex justify-space-between mt-1" style="font-size: 11px; color: var(--text-secondary);">
                            <span>Total:</span>
                            <span class="text-gold tabular-nums" style="font-weight: 700;">Bs. @mesa.MontoTotalCalculado.ToString("N2")</span>
                        </div>
                    }
                    else
                    {
                        <div class="mt-2 text-center py-2" style="font-size: 12px; color: var(--text-muted);">
                            Bs. @(mesa.Tarifa?.PrecioPorHora.ToString("N2") ?? "25.00")/hr
                        </div>
                    }
                </div>
            </MudItem>
        }
    </MudGrid>
</div>

@code {
    private List<MesaModel> _mesas = new();
    private CajaModel? _caja;
    private int _productosBajoStock;
    private System.Threading.Timer? _timerTick;

    protected override async Task OnInitializedAsync()
    {
        await CargarDashboardAsync();

        // Tick local para actualizar cronómetros del resumen
        _timerTick = new System.Threading.Timer(_ =>
        {
            foreach (var mesa in _mesas.Where(m => m.Estado == "ocupada" || m.Estado == "pausada"))
            {
                Supabase.CalcularTiempoYMontoMesa(mesa);
            }
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private async Task CargarDashboardAsync()
    {
        _mesas = await Supabase.GetMesasAsync();
        _caja = await Supabase.GetCajaAbiertaAsync();
        var productos = await Supabase.GetProductosAsync();
        _productosBajoStock = productos.Count(p => p.StockBajo);
    }

    public void Dispose()
    {
        _timerTick?.Dispose();
    }
}
